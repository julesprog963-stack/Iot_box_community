<odoo>
    <record id="view_pos_printer_form_pos_community_iot" model="ir.ui.view">
        <field name="name">pos.printer.form.pos.community.iot</field>
        <field name="model">pos.printer</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_printer_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='proxy_ip']" position="after">
                <field name="community_iot_enabled"/>
                <field name="community_iot_box_id" invisible="not community_iot_enabled"/>
                <field name="community_iot_device_id" invisible="not community_iot_enabled" domain="[('box_id', '=', community_iot_box_id), ('type', 'in', ('ticket_printer', 'standard_printer')), ('active', '=', True)]"/>
                <field name="community_iot_copies" invisible="not community_iot_enabled"/>
            </xpath>
            <xpath expr="//sheet/group" position="inside">
                <button name="action_print_test_page" type="object" string="Print test page" class="btn-primary" invisible="not community_iot_enabled or not community_iot_device_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_printer_tree_pos_community_iot" model="ir.ui.view">
        <field name="name">pos.printer.tree.pos.community.iot</field>
        <field name="model">pos.printer</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_printer"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='proxy_ip']" position="after">
                <field name="community_iot_enabled" optional="show"/>
                <field name="community_iot_device_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
