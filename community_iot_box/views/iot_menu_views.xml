<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_test_connection_server" model="ir.actions.server">
        <field name="name">Test connection</field>
        <field name="model_id" ref="model_community_iot_box_iot_box"/>
        <field name="state">code</field>
        <field name="code">
action = {
    "type": "ir.actions.client",
    "tag": "display_notification",
    "params": {
        "title": "Test connection",
        "message": "Connection test will be available soon.",
        "type": "info",
        "sticky": False,
    },
}
        </field>
    </record>

    <record id="view_community_iot_box_kanban" model="ir.ui.view">
        <field name="name">community.iot.box.kanban</field>
        <field name="model">community_iot_box.iot_box</field>
        <field name="arch" type="xml">
            <kanban class="o_community_iot_box_kanban">
                <field name="name"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="last_seen"/>
                <field name="device_count"/>
                <field name="token"/>
                <field name="ip_address"/>
                <field name="agent_version"/>
                <field name="hostname"/>
                <templates>
                    <t t-name="card">
                        <div t-att-class="'oe_kanban_global_click o_ciot_card o_ciot_state_' + (record.state.raw_value || 'draft')">
                            <div class="o_ciot_state_bar"/>
                            <div class="o_ciot_main_col">
                                <div class="o_ciot_head">
                                    <div class="o_ciot_identity">
                                        <span class="o_ciot_icon_col">
                                            <i class="fa fa-server o_ciot_icon" title="IoT Box"/>
                                        </span>
                                        <div class="o_ciot_title_group">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                            <span class="o_ciot_company"><field name="company_id"/></span>
                                        </div>
                                    </div>
                                    <span t-att-class="'o_ciot_state_badge o_ciot_state_badge_' + (record.state.raw_value || 'draft')">
                                        <i class="fa fa-circle" title="Status"/>
                                        <field name="state"/>
                                    </span>
                                </div>

                                <div class="o_ciot_details">
                                    <div class="o_ciot_detail">
                                        <span class="o_ciot_detail_label">Address</span>
                                        <span t-if="record.ip_address.value" class="o_ciot_detail_value"><field name="ip_address"/></span>
                                        <span t-if="!record.ip_address.value" class="o_ciot_detail_empty">Not configured</span>
                                    </div>
                                    <div class="o_ciot_detail">
                                        <span class="o_ciot_detail_label">Agent</span>
                                        <span t-if="record.agent_version.value" class="o_ciot_detail_value"><field name="agent_version"/></span>
                                        <span t-if="!record.agent_version.value" class="o_ciot_detail_empty">No version reported</span>
                                    </div>
                                    <div class="o_ciot_detail">
                                        <span class="o_ciot_detail_label">Last heartbeat</span>
                                        <span t-if="record.last_seen.value" class="o_ciot_detail_value"><field name="last_seen"/></span>
                                        <span t-if="!record.last_seen.value" class="o_ciot_detail_empty">No connection recorded</span>
                                    </div>
                                </div>

                                <div class="o_ciot_footer">
                                    <span class="o_ciot_devices_count">
                                        <i class="fa fa-cubes" title="Devices"/> <field name="device_count"/> devices
                                    </span>
                                    <span t-if="record.token.value" class="o_ciot_token o_ciot_token_ready">
                                        <i class="fa fa-check"/> Token configured
                                    </span>
                                    <span t-if="!record.token.value" class="o_ciot_token o_ciot_token_missing">
                                        <i class="fa fa-exclamation-triangle"/> No token
                                    </span>
                                </div>

                                <div class="o_ciot_actions">
                                    <a t-if="record.ip_address.value"
                                       t-att-href="'http://' + record.ip_address.value"
                                       target="_blank"
                                       role="button"
                                       class="btn btn-outline-primary btn-sm">
                                        Open interface <i class="fa fa-external-link"/>
                                    </a>
                                    <span t-if="!record.ip_address.value" class="o_ciot_action_disabled">
                                        Configure an IP address to open the interface
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_community_iot_box_tree" model="ir.ui.view">
        <field name="name">community.iot.box.tree</field>
        <field name="model">community_iot_box.iot_box</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="last_seen"/>
                <field name="device_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_community_iot_devices_from_box" model="ir.actions.act_window">
        <field name="name">IoT Devices</field>
        <field name="res_model">community_iot_box.iot_device</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('box_id', '=', active_id)]</field>
        <field name="context">{'default_box_id': active_id}</field>
    </record>

    <record id="action_community_iot_jobs_from_box" model="ir.actions.act_window">
        <field name="name">IoT Jobs</field>
        <field name="res_model">community_iot_box.iot_job</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('box_id', '=', active_id)]</field>
        <field name="context">{'default_box_id': active_id}</field>
    </record>

    <record id="view_community_iot_box_form" model="ir.ui.view">
        <field name="name">community.iot.box.form</field>
        <field name="model">community_iot_box.iot_box</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" class="oe_stat_button" name="action_test_connection" icon="fa-plug">
                            <span>Test connection</span>
                        </button>
                        <button type="action" class="oe_stat_button" name="%(action_community_iot_devices_from_box)d" icon="fa-cubes">
                            <field name="device_count" widget="statinfo" string="Devices"/>
                        </button>
                        <button type="action" class="oe_stat_button" name="%(action_community_iot_jobs_from_box)d" icon="fa-tasks">
                            <field name="job_ids" widget="statinfo" string="Jobs"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="IoT Box"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="ip_address"/>
                            <field name="ip_address" widget="url" string="IoT Box Home Page" options="{'prefix': 'http://'}"/>
                            <field name="agent_version" string="Image Version"/>
                            <field name="agent_capabilities" readonly="1"/>
                            <field name="pdf_print_capable" readonly="1"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="hostname"/>
                            <field name="box_uid"/>
                            <field name="token" password="1" readonly="1"/>
                            <button
                                name="action_generate_token"
                                string="Generate token"
                                type="object"
                                class="btn-secondary"
                            />
                            <field name="state"/>
                            <field name="last_seen"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Devices">
                            <field name="device_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="device_key" string="Identifier"/>
                                    <field name="backend" string="Manufacturer"/>
                                    <field name="interface" string="Connection Type"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Jobs">
                            <field name="job_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="device_id"/>
                                    <field name="job_type"/>
                                    <field name="state"/>
                                    <field name="result_status"/>
                                    <field name="result_message"/>
                                    <field name="attempt_count"/>
                                    <field name="lease_expires_at"/>
                                    <field name="processed_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_community_iot_boxes" model="ir.actions.act_window">
        <field name="name">IoT Boxes</field>
        <field name="res_model">community_iot_box.iot_box</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_community_iot_box_kanban"/>
    </record>

    <record id="view_community_iot_device_tree" model="ir.ui.view">
        <field name="name">community.iot.device.tree</field>
        <field name="model">community_iot_box.iot_device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="box_id"/>
                <field name="device_key"/>
                <field name="type"/>
                <field name="backend"/>
                <field name="interface"/>
                <field name="cups_printer_name"/>
                <field name="auto_detected"/>
                <field name="last_discovered_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_community_iot_device_form" model="ir.ui.view">
        <field name="name">community.iot.device.form</field>
        <field name="model">community_iot_box.iot_device</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_print_test_page"
                            string="Print test page"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-print"
                            invisible="type not in ('ticket_printer', 'standard_printer')"
                        />
                    </div>

                    <group string="General">
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="box_id"/>
                            <field name="auto_detected" readonly="1"/>
                            <field name="discovery_source" readonly="1" invisible="not auto_detected"/>
                        </group>
                        <group>
                            <field name="device_key"/>
                            <field name="type"/>
                            <field name="backend"/>
                            <field name="interface"/>
                            <field name="ticket_mode" invisible="type not in ('ticket_printer', 'standard_printer')"/>
                            <field name="last_discovered_at" readonly="1" invisible="not auto_detected"/>
                        </group>
                    </group>

                    <group string="Connection">
                        <group>
                            <field name="connection_host" invisible="interface not in ('network',)"/>
                            <field name="connection_port" invisible="interface not in ('network',)"/>
                            <field name="connection_device" invisible="interface not in ('serial', 'usb')"/>
                            <field name="serial_baudrate" invisible="interface != 'serial'"/>
                        </group>
                        <group>
                            <field name="cups_printer_name" invisible="type != 'standard_printer' and interface != 'cups'"/>
                            <field name="usb_vendor_id" invisible="interface != 'usb'"/>
                            <field name="usb_product_id" invisible="interface != 'usb'"/>
                            <field name="usb_interface" invisible="interface != 'usb'"/>
                            <field name="usb_in_ep" invisible="interface != 'usb'"/>
                            <field name="usb_out_ep" invisible="interface != 'usb'"/>
                        </group>
                    </group>

                    <group string="Status">
                        <field name="last_test_status"/>
                        <field name="last_test_date"/>
                    </group>

                    <group string="Notes">
                        <field name="notes"/>
                        <field name="discovery_payload" readonly="1" invisible="not auto_detected"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_community_iot_devices" model="ir.actions.act_window">
        <field name="name">IoT Devices</field>
        <field name="res_model">community_iot_box.iot_device</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="view_community_iot_job_tree" model="ir.ui.view">
        <field name="name">community.iot.job.tree</field>
        <field name="model">community_iot_box.iot_job</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="box_id"/>
                <field name="device_id"/>
                <field name="job_type"/>
                <field name="state"/>
                <field name="result_status"/>
                <field name="result_message"/>
                <field name="attempt_count"/>
                <field name="lease_expires_at"/>
                <field name="processed_at"/>
            </list>
        </field>
    </record>

    <record id="view_community_iot_job_form" model="ir.ui.view">
        <field name="name">community.iot.job.form</field>
        <field name="model">community_iot_box.iot_job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_retry_document" type="object" string="Retry PDF" class="btn-primary" invisible="job_type != 'document_print' or state != 'failed'"/>
                    <button name="action_cancel_document" type="object" string="Cancel PDF" invisible="job_type != 'document_print' or state in ('done', 'cancelled')"/>
                </header>
                <sheet>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="company_id" readonly="1"/>
                            <field name="box_id"/>
                            <field name="device_id"/>
                            <field name="device_key"/>
                            <field name="job_type"/>
                        </group>
                        <group string="Execution">
                            <field name="state"/>
                            <field name="result_status"/>
                            <field name="result_message"/>
                            <field name="claimed_at"/>
                            <field name="lease_expires_at"/>
                            <field name="attempt_count"/>
                            <field name="processed_at"/>
                            <field name="error_code"/>
                        </group>
                    </group>

                    <group string="Payload">
                        <field name="payload"/>
                    </group>

                    <group string="PDF Document" invisible="job_type != 'document_print'">
                        <field name="document_attachment_id"/>
                        <field name="document_filename"/>
                        <field name="document_mimetype"/>
                        <field name="document_size"/>
                        <field name="document_sha256"/>
                        <field name="document_expires_at"/>
                    </group>

                    <group string="Errors">
                        <field name="error_message"/>
                    </group>

                    <group string="Agent Log">
                        <field name="agent_log"/>
                    </group>

                    <group string="Origin">
                        <field name="origin_model"/>
                        <field name="origin_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_community_iot_jobs" model="ir.actions.act_window">
        <field name="name">IoT Jobs</field>
        <field name="res_model">community_iot_box.iot_job</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_community_iot_dashboard" model="ir.actions.client">
        <field name="name">IoT Box Community</field>
        <field name="tag">community_iot_box.dashboard</field>
    </record>

    <menuitem
        id="menu_community_iot_root"
        name="IoT Box Community"
        groups="base.group_system"
        action="action_community_iot_dashboard"
        sequence="10"
        web_icon="community_iot_box,static/description/icon.png"
    />

    <menuitem
        id="menu_community_iot_dashboard"
        name="Dashboard"
        parent="menu_community_iot_root"
        action="action_community_iot_dashboard"
        sequence="5"
    />

    <menuitem
        id="menu_community_iot_boxes"
        name="IoT Boxes"
        parent="menu_community_iot_root"
        action="action_community_iot_boxes"
        sequence="10"
    />

    <menuitem
        id="menu_community_iot_devices"
        name="IoT Devices"
        parent="menu_community_iot_root"
        action="action_community_iot_devices"
        sequence="20"
    />

    <menuitem
        id="menu_community_iot_jobs"
        name="IoT Jobs"
        parent="menu_community_iot_root"
        action="action_community_iot_jobs"
        sequence="30"
    />
</odoo>
