<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_community_iot_print_wizard_form" model="ir.ui.view">
        <field name="name">community.iot.print.wizard.form</field>
        <field name="model">community.iot.print.wizard</field>
        <field name="arch" type="xml">
            <form string="IoT Print">
                <group>
                    <field name="company_id"/>
                    <field name="report_action_id"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_ids_json" invisible="1"/>
                    <field name="device_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="copies"/>
                    <field name="filename"/>
                </group>
                <footer>
                    <button name="action_print" string="Queue PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
