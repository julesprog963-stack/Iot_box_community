<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_community_iot_printing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.community.iot.printing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Community IoT Printing" name="community_iot_printing" groups="base.group_system">
                    <block title="PDF Printing">
                        <setting string="Default IoT PDF printer" help="Prefills the printer in the IoT Print assistant.">
                            <field name="community_iot_print_device_id"/>
                        </setting>
                        <setting string="Default copies">
                            <field name="community_iot_print_copies"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
